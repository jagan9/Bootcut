  (function() {
    const openBtn = document.getElementById('open-delete-account-modal');
    const modal = document.getElementById('delete-account-modal');
    const backdrop = document.getElementById('delete-modal-backdrop');
    const closeBtn = document.getElementById('close-delete-modal-btn');
    const cancelBtn = document.getElementById('cancel-delete-modal-btn');
    const confirmBtn = document.getElementById('confirm-delete-account-btn');
    const inputConfirm = document.getElementById('delete-confirm-input');
    const checkConfirm = document.getElementById('delete-acknowledgment-check');
    const confirmLabel = document.getElementById('confirm-btn-label');

    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      if (inputConfirm) inputConfirm.value = '';
      if (checkConfirm) checkConfirm.checked = false;
      updateDeleteButtonState();
      setTimeout(() => { if (inputConfirm) inputConfirm.focus(); }, 100);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      if (inputConfirm) inputConfirm.value = '';
      if (checkConfirm) checkConfirm.checked = false;
      updateDeleteButtonState();
    }

    function updateDeleteButtonState() {
      if (!confirmBtn) return;
      const textValid = inputConfirm && inputConfirm.value.trim().toUpperCase() === 'DELETE';
      const checkValid = checkConfirm && checkConfirm.checked;
      const isValid = textValid && checkValid;

      if (isValid) {
        confirmBtn.disabled = false;
        confirmBtn.classList.remove('opacity-40', 'cursor-not-allowed');
        confirmBtn.classList.add('hover:opacity-90', 'cursor-pointer');
      } else {
        confirmBtn.disabled = true;
        confirmBtn.classList.add('opacity-40', 'cursor-not-allowed');
        confirmBtn.classList.remove('hover:opacity-90', 'cursor-pointer');
      }
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);

    if (inputConfirm) inputConfirm.addEventListener('input', updateDeleteButtonState);
    if (checkConfirm) checkConfirm.addEventListener('change', updateDeleteButtonState);

    if (confirmBtn) {
      confirmBtn.addEventListener('click', function() {
        if (confirmBtn.disabled) return;
        confirmBtn.disabled = true;
        confirmLabel.textContent = 'Erasing Data...';
        confirmBtn.classList.add('opacity-75');
        setTimeout(function() {
          confirmLabel.textContent = 'Account Erased';
          setTimeout(function() {
            closeModal();
            confirmLabel.textContent = 'Permanently Delete Account';
            alert('Account erasure request submitted. You have been scheduled for deletion.');
          }, 800);
        }, 1200);
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
