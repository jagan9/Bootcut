<script>
  (() => {
    // 1. Search Filtering Logic
    const searchInput = document.getElementById('project-search');
    const clearBtn = document.getElementById('clear-search');
    const projectCards = document.querySelectorAll('.project-item');
    const filterChips = document.querySelectorAll('.filter-chip');

    let currentFilter = 'all';

    function runFilter() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      
      projectCards.forEach(card => {
        const title = (card.getAttribute('data-title') || '').toLowerCase();
        const status = card.getAttribute('data-status');

        const matchesQuery = query === '' || title.includes(query);
        const matchesStatus = currentFilter === 'all' || status === currentFilter;

        if (matchesQuery && matchesStatus) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    searchInput?.addEventListener('input', (e) => {
      if (searchInput.value.length > 0) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }
      runFilter();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      clearBtn.classList.add('hidden');
      runFilter();
    });

    // 2. Status Chips
    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filterChips.forEach(c => {
          c.classList.remove('bg-primary-container', 'text-on-primary-container');
          c.classList.add('bg-surface-container-high', 'text-on-surface-variant');
        });
        chip.classList.add('bg-primary-container', 'text-on-primary-container');
        chip.classList.remove('bg-surface-container-high', 'text-on-surface-variant');

        currentFilter = chip.getAttribute('data-filter') || 'all';
        runFilter();
      });
    });

    // 3. Compact vs Grid View Toggle
    const btnCard = document.getElementById('view-card');
    const btnCompact = document.getElementById('view-compact');
    const container = document.getElementById('projects-container');

    btnCompact?.addEventListener('click', () => {
      btnCompact.classList.add('bg-surface', 'text-primary');
      btnCompact.classList.remove('text-on-surface-variant');
      btnCard?.classList.remove('bg-surface', 'text-primary');
      btnCard?.classList.add('text-on-surface-variant');

      // Shift cards to compact preview heights
      projectCards.forEach(card => {
        const preview = card.querySelector('.relative.w-full.h-44');
        if (preview) {
          preview.classList.remove('h-44');
          preview.classList.add('h-24');
        }
      });
    });

    btnCard?.addEventListener('click', () => {
      btnCard.classList.add('bg-surface', 'text-primary');
      btnCard.classList.remove('text-on-surface-variant');
      btnCompact?.classList.remove('bg-surface', 'text-primary');
      btnCompact?.classList.add('text-on-surface-variant');

      projectCards.forEach(card => {
        const preview = card.querySelector('.relative.w-full');
        if (preview) {
          preview.classList.remove('h-24');
          preview.classList.add('h-44');
        }
      });
    });

    // 4. Sort dropdown rotation demo
    const sortTrigger = document.getElementById('sort-trigger');
    const sortLabel = document.getElementById('current-sort');
    const sorts = ['Recently Edited', 'Created Date', 'Duration', 'Title A-Z'];
    let sortIdx = 0;

    sortTrigger?.addEventListener('click', () => {
      sortIdx = (sortIdx + 1) % sorts.length;
      if (sortLabel) sortLabel.textContent = sorts[sortIdx];
    });

    // 5. Overflow feedback simulation
    document.querySelectorAll('.project-menu-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        btn.classList.add('scale-90');
        setTimeout(() => btn.classList.remove('scale-90'), 150);
      });
    });
  })();
