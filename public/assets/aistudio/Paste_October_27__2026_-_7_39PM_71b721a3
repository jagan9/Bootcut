    const form = document.getElementById('reset-form');
    const successCard = document.getElementById('success-state');

    if (!emailInput.value) return;

    targetEmail.textContent = emailInput.value;
    form.classList.add('hidden');
    successCard.classList.remove('hidden');

    startCountdown();
  }

  function resetDemoView() {
    const form = document.getElementById('reset-form');
    const successCard = document.getElementById('success-state');
    clearInterval(countdownTimer);
    successCard.classList.add('hidden');
    form.classList.remove('hidden');
  }

  function startCountdown() {
    clearInterval(countdownTimer);
    let duration = 14 * 60 + 59;
    const countdownEl = document.getElementById('countdown');

    countdownTimer = setInterval(() => {
      const minutes = Math.floor(duration / 60);
      const seconds = duration % 60;
      countdownEl.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      if (--duration < 0) {
        clearInterval(countdownTimer);
        countdownEl.textContent = "00:00 (Expired)";
      }
    }, 1000);
  }

  function triggerResend() {
    const resendText = document.getElementById('resend-text');
    resendText.textContent = "Sent!";
