<script>
  (function initSignUpMicroInteractions() {
    const passwordInput = document.getElementById('password');
    const togglePasswordBtn = document.getElementById('togglePasswordBtn');
    const eyeIcon = document.getElementById('eyeIcon');
    const termsCheckbox = document.getElementById('termsCheckbox');
    const customCheckboxBox = document.getElementById('customCheckboxBox');
    const checkboxIcon = document.getElementById('checkboxIcon');
    const strengthText = document.getElementById('strengthText');
    const submitBtn = document.getElementById('submitBtn');

    const barLength = document.getElementById('barLength');
    const barNumber = document.getElementById('barNumber');
    const barSymbol = document.getElementById('barSymbol');
    const barCase = document.getElementById('barCase');

    const ruleLength = document.getElementById('ruleLength');
    const ruleNumber = document.getElementById('ruleNumber');
    const ruleSymbol = document.getElementById('ruleSymbol');
    const ruleCase = document.getElementById('ruleCase');

    // 1. Password Visibility Toggle
    if (togglePasswordBtn && passwordInput && eyeIcon) {
      togglePasswordBtn.addEventListener('click', () => {
        const isPassword = passwordInput.getAttribute('type') === 'password';
        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
        eyeIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
        eyeIcon.classList.toggle('text-primary', isPassword);
      });
    }

    // 2. Interactive Reactive Checkbox
    if (termsCheckbox && customCheckboxBox && checkboxIcon) {
      termsCheckbox.addEventListener('change', () => {
        const isChecked = termsCheckbox.checked;
        if (isChecked) {
          customCheckboxBox.className = "w-5 h-5 rounded bg-primary text-on-primary flex items-center justify-center shrink-0 mt-0.5 transition-transform duration-150 active:scale-90 shadow-sm";
          checkboxIcon.style.opacity = '1';
        } else {
          customCheckboxBox.className = "w-5 h-5 rounded bg-surface-container-highest text-transparent flex items-center justify-center shrink-0 mt-0.5 transition-transform duration-150 active:scale-90";
          checkboxIcon.style.opacity = '0';
        }
      });
    }

    // 3. Real-time Password Strength Meter Calculator
    function updatePasswordMeter() {
      const val = passwordInput ? passwordInput.value : '';
      const hasLength = val.length >= 8;
      const hasNumber = /\d/.test(val);
      const hasSymbol = /[^A-Za-z0-9]/.test(val);
      const hasMixedCase = /[a-z]/.test(val) && /[A-Z]/.test(val);

      const updateRuleUI = (element, barElement, isValid) => {
        if (!element || !barElement) return;
        const icon = element.querySelector('.material-symbols-outlined');
        if (isValid) {
          element.className = 'flex items-center gap-1 text-primary';
          if (icon) icon.textContent = 'check_circle';
          barElement.className = 'h-full rounded-full bg-primary transition-all duration-300 shadow-[0_0_6px_#c0c1ff]';
        } else {
          element.className = 'flex items-center gap-1 text-outline-variant';
          if (icon) icon.textContent = 'radio_button_unchecked';
          barElement.className = 'h-full rounded-full bg-surface-container-highest transition-all duration-300';
        }
      };

      updateRuleUI(ruleLength, barLength, hasLength);
      updateRuleUI(ruleNumber, barNumber, hasNumber);
      updateRuleUI(ruleSymbol, barSymbol, hasSymbol);
      updateRuleUI(ruleCase, barCase, hasMixedCase);

      const score = [hasLength, hasNumber, hasSymbol, hasMixedCase].filter(Boolean).length;
      if (!strengthText) return;

      if (val.length === 0) {
        strengthText.textContent = 'Enter password';
        strengthText.className = 'font-label-code-sm text-label-code-sm text-outline';
      } else if (score <= 1) {
        strengthText.textContent = 'Weak';
        strengthText.className = 'font-label-code-sm text-label-code-sm text-error font-medium';
      } else if (score === 2) {
        strengthText.textContent = 'Fair';
        strengthText.className = 'font-label-code-sm text-label-code-sm text-secondary font-medium';
      } else if (score === 3) {
        strengthText.textContent = 'Good';
        strengthText.className = 'font-label-code-sm text-label-code-sm text-tertiary font-medium';
      } else {
        strengthText.textContent = 'Strong';
        strengthText.className = 'font-label-code-sm text-label-code-sm text-primary font-medium tracking-wide';
      }
    }

    if (passwordInput) {
      passwordInput.addEventListener('input', updatePasswordMeter);
      updatePasswordMeter();
    }

    // 4. Submit Micro Feedback
    if (submitBtn) {
      submitBtn.addEventListener('click', () => {
        if (!termsCheckbox.checked) {
          customCheckboxBox.classList.add('animate-bounce');
          setTimeout(() => customCheckboxBox.classList.remove('animate-bounce'), 600);
          return;
        }
        submitBtn.classList.add('scale-95', 'opacity-90');
        const originalContent = submitBtn.innerHTML;
        submitBtn.innerHTML = `
          <span class="w-4 h-4 border-2 border-on-primary border-t-transparent rounded-full animate-spin"></span>
          <span>Syncing BeatVault...</span>
        `;
        setTimeout(() => {
          submitBtn.classList.remove('scale-95', 'opacity-90');
          submitBtn.innerHTML = `
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>Welcome, Alex!</span>
          `;
          setTimeout(() => {
            submitBtn.innerHTML = originalContent;
          }, 2400);
        }, 1200);
      });
    }
  })();
</script></main></body></html>

